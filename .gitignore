# =============================================================================
# FlujoFormato_clonacion — .gitignore (raíz)
# Nunca subir secretos ni basura de corridas a GitHub.
# =============================================================================

# --- Secretos / OAuth / entorno ---
.env
**/.env
credentials.json
**/credentials.json
credenciales.json
**/credenciales.json
token.json
**/token.json

# --- Certificados del equipo (se regeneran solos en cada corrida) ---
certificados_confianza.pem
**/certificados_confianza.pem

# --- Artefactos de corridas ---
corridas/
*.log
**/clonacion.log
hoja_inventario_id.txt
**/hoja_inventario_id.txt
reporte_inventario_clon.xlsx
reporte_comparacion_clon.txt
**/lms_base_rutas.csv
**/lms_base_final.csv
**/lms_prueba.csv
*.csv

# --- Excel de trabajo local (el equipo usa el suyo) ---
RUTAS.xlsx
**/RUTAS.xlsx
RUTAS_prueba.xlsx

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env/

# --- SO / IDE ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Despliegue en Cloud Run -------------------------------------------------
# La plantilla (variables.env.example) SI se versiona; el archivo relleno con
# valores reales del proyecto, no.
despliegue/variables.env
despliegue/*.env
!despliegue/variables.env.example
# Claves de cuenta de servicio descargadas al preparar los secretos.
clave-*.json
*-sa.json
sa-*.json
