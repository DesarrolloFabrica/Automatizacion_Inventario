# =============================================================================
# despliegue/variables.env.example
# Plantilla de las variables de entorno del servicio desplegado en Cloud Run.
#
# COMO SE USA
#   1. Copia este archivo:   copy despliegue\variables.env.example despliegue\variables.env
#   2. Rellena los valores entre < > con los reales del proyecto.
#   3. despliegue\desplegar.ps1 lo lee y arma el "gcloud run deploy".
#
# REGLAS
#   * despliegue\variables.env NO se sube a Git (esta en .gitignore).
#   * Aqui NO van contrasenas ni credenciales: esas viven en Secret Manager y se
#     montan aparte (ver la seccion "Secretos" al final y despliegue/README.md).
#   * Sin comillas y sin espacios alrededor del "=": NOMBRE=valor.
#   * Los nombres de estas variables tienen que coincidir con los que lee
#     servidor/app.py. Si el servidor cambia un nombre, se cambia aqui tambien.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Identidad del despliegue (las usa el script, no la aplicacion)
# -----------------------------------------------------------------------------

# Proyecto de Google Cloud donde vive todo.
PROYECTO=it-fab-contenido-edu-1

# Region de Cloud Run. Debe ser la MISMA que la de la instancia de Cloud SQL y
# la del bucket, para que no haya latencia ni coste de salida entre regiones.
# Ejemplo: us-central1
REGION=<REGION>

# Nombre del servicio de Cloud Run (aparece en la URL).
SERVICIO=fabrica-contenido-web

# Cuenta de servicio con la que corre el servicio (la que tiene los permisos).
CUENTA_SERVICIO=<NOMBRE_CUENTA>@it-fab-contenido-edu-1.iam.gserviceaccount.com


# -----------------------------------------------------------------------------
# 2. Base de datos (Cloud SQL — PostgreSQL, instancia planner-postgres)
# -----------------------------------------------------------------------------

# Nombre de conexion de la instancia, en formato PROYECTO:REGION:INSTANCIA.
# Se obtiene con:  gcloud sql instances describe planner-postgres --format="value(connectionName)"
CLOUD_SQL_CONNECTION_NAME=it-fab-contenido-edu-1:<REGION>:planner-postgres

# Conexion por socket Unix del conector de Cloud Run: el host NO es una IP, es la
# carpeta /cloudsql/<nombre de conexion>. Asi no hay que autorizar ninguna IP.
DB_HOST=/cloudsql/it-fab-contenido-edu-1:<REGION>:planner-postgres
DB_PORT=5432
DB_NAME=planner_db
DB_USER=<USUARIO_BD>
# DB_PASSWORD NO va aqui: llega desde Secret Manager (ver seccion 7).

# Esquema al que carga el flujo si la persona no elige otro en la web.
# Se deja en pruebas a proposito: para escribir en produccion hay que pedirlo
# expresamente en cada corrida.
#   fabrica_pruebas = pruebas     |     fabrica = PRODUCCION
SCHEMA_POR_DEFECTO=fabrica_pruebas

# Misma idea, pero para el codigo heredado de LMS_Fabrica/lms_lib, que lee esta
# variable al importarse. Conviene dejarla igual que SCHEMA_POR_DEFECTO.
LMS_SCHEMA=fabrica_pruebas


# -----------------------------------------------------------------------------
# 3. Estado de las corridas
# -----------------------------------------------------------------------------

# Bucket de Cloud Storage donde se guardan el estado JSON, el Excel de estado y
# los logs de cada corrida. Sin el prefijo "gs://". Es lo que hace que el
# historial sobreviva a un reinicio del servicio.
BUCKET_ESTADO=<NOMBRE_BUCKET_ESTADO>

# Destino completo del almacen de corridas, tal y como lo espera
# flujo_lib.almacen.crear_almacen():
#   gs://bucket/prefijo  -> Cloud Storage (lo normal en el servicio desplegado)
#   una ruta             -> carpeta local (lo normal al ejecutar en tu equipo)
ALMACEN_CORRIDAS=gs://<NOMBRE_BUCKET_ESTADO>/corridas

# Carpeta local del contenedor para los archivos temporales de la corrida, antes
# de subirlos al almacen. Ojo: el disco del contenedor es memoria RAM y se borra
# en cada reinicio; nada que tenga que durar se queda aqui.
DIR_CORRIDAS=/app/corridas


# -----------------------------------------------------------------------------
# 4. Correos de aviso
# -----------------------------------------------------------------------------

# Destinatarios del correo final de cada corrida, separados por coma y sin
# espacios. Se envian desde la cuenta fabrica de contenidos (Gmail API).
CORREOS_AVISO=<correo1@cun.edu.co>,<correo2@cun.edu.co>


# -----------------------------------------------------------------------------
# 5. Credenciales de Google (Drive, Sheets y Gmail)
# -----------------------------------------------------------------------------

# De donde salen las credenciales. Dos opciones, explicadas en despliegue/README.md:
#   token             = token OAuth de usuario (token.json) guardado como secreto.
#                       Funciona hoy mismo, pero caduca y puede ser revocado.
#   cuenta_servicio   = cuenta de servicio con delegacion de dominio que actua en
#                       nombre de fabricadecontenidos@cun.edu.co. Es lo correcto a
#                       largo plazo; necesita que el administrador de Google
#                       Workspace de la CUN la autorice.
GOOGLE_CREDENCIALES_MODO=token

# Ruta del archivo del secreto DENTRO del contenedor (lo monta Cloud Run).
# Solo se usa con GOOGLE_CREDENCIALES_MODO=token.
# No se monta en /app/token.json a proposito: Cloud Run monta el directorio
# completo del secreto y taparia el codigo de /app.
GOOGLE_TOKEN_JSON=/secretos/token.json

# Ruta del archivo de la clave de la cuenta de servicio dentro del contenedor.
# Solo se usa con GOOGLE_CREDENCIALES_MODO=cuenta_servicio.
GOOGLE_SA_JSON=/secretos/cuenta-servicio.json

# Buzon al que suplanta la cuenta de servicio (el dueno de las carpetas de Drive
# y el remitente de los correos). Solo con GOOGLE_CREDENCIALES_MODO=cuenta_servicio.
GOOGLE_USUARIO_SUPLANTADO=fabricadecontenidos@cun.edu.co


# -----------------------------------------------------------------------------
# 6. Comportamiento del servicio
# -----------------------------------------------------------------------------

# Modo simulacion por defecto: la corrida recorre todo el flujo pero NO escribe
# en la base ni envia correo. Se deja encendido (1) a proposito; quien lanza la
# corrida tiene que apagarlo expresamente desde la web.
SIMULAR_POR_DEFECTO=1

# Permitir cargar lotes con diferencias de verificacion. Apagado: la compuerta
# retiene los lotes que no cuadran (equivale a NO usar --forzar-carga).
FORZAR_CARGA_POR_DEFECTO=0

# Zona horaria de las fechas que se muestran y se escriben en los informes.
TZ=America/Bogota

# Puerto de escucha. En Cloud Run lo inyecta la plataforma; se deja documentado
# para ejecutar la imagen en local. NO lo declares en el despliegue.
PORT=8080


# -----------------------------------------------------------------------------
# 7. Secretos (referencia — NO se escriben en este archivo)
# -----------------------------------------------------------------------------
# Se montan en el despliegue con --set-secrets. Nombres sugeridos:
#
#   DB_PASSWORD                -> secreto "fabrica-db-password"   (variable de entorno)
#   /secretos/token.json       -> secreto "fabrica-google-token"  (archivo, modo token)
#   /secretos/cuenta-servicio.json
#                              -> secreto "fabrica-google-sa"     (archivo, modo cuenta_servicio)
#
# Comando exacto en despliegue/README.md, seccion "Secretos".
