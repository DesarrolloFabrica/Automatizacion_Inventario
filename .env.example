# Plantilla de entorno (raiz)
# Copia este archivo a .env y completa los valores.
# NO subir .env a Git.
#
# Tambien puedes usar:
#   CLONACION_CARPETA/.env
#   LMS_Fabrica/.env

# Destinatarios de los correos (clon y carga GCP), separados por coma.
CORREOS_AVISO=correo1@cun.edu.co,correo2@cun.edu.co

# Conexion a Cloud SQL (solo hace falta para LMS_Fabrica / cargar_base_gcp.py)
DB_HOST=
DB_PORT=5432
DB_NAME=planner_db
DB_USER=
DB_PASSWORD=

# Esquema oficial normalizado desde 2026-10-19; temporal = fabrica1.
LMS_SCHEMA=fabrica
SCHEMA_POR_DEFECTO=fabrica

# -----------------------------------------------------------------------------
# Acceso a la pagina web (servidor/app.py)
# -----------------------------------------------------------------------------
# Para entrar hay que iniciar sesion con Google Y estar en USUARIOS_PERMITIDOS.
# Tambien en local: crea un "ID de cliente de OAuth" de tipo Aplicacion web en
# la consola de Google Cloud y registra esta URI de redireccionamiento:
#   http://localhost:8080/api/sesion/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Correos autorizados, separados por coma. Quien no este aqui no entra.
USUARIOS_PERMITIDOS=tu.correo@cun.edu.co

# Cadena al azar que firma la cookie de sesion. Generala una vez con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Si la dejas vacia se inventa una en cada arranque y tendras que volver a entrar.
SESION_SECRETO=

# En local se trabaja por http://localhost, donde una cookie "Secure" no se
# guardaria nunca. En el servidor desplegado (https) esto va en 1.
COOKIE_SEGURA=0

# Horas que dura la sesion. Opcional; por defecto 8.
HORAS_SESION=8
